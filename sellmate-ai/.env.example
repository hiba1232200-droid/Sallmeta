# =============================================================================
# SellMate AI — نموذج متغيرات البيئة
# انسخ إلى .env وعدّل القيم. لا تضع أي مفتاح API داخل الكود — كلها هنا.
# لا ترفع ملف .env إلى Git إطلاقًا.
#
# في الإنتاج (NODE_ENV=production) يُفرَض تلقائيًا:
#   • JWT_SECRET بطول 32 حرفًا فأكثر        (openssl rand -base64 48)
#   • ENCRYPTION_KEY إلزامي (base64 لـ 32 بايت) (openssl rand -base64 32)
#   • TELEGRAM_WEBHOOK_SECRET بطول 16 حرفًا فأكثر
# على Railway: DATABASE_URL و PORT تُضبطان تلقائيًا — لا تضبطهما يدويًا.
# =============================================================================

NODE_ENV=development
API_PORT=4000
# PORT: تضبطه المنصّة (Railway/Docker) تلقائيًا؛ يتقدّم على API_PORT عند وجوده.

# --- PostgreSQL (يستخدمها docker-compose.yml لإنشاء القاعدة محليًا) ---
POSTGRES_USER=sellmate
POSTGRES_PASSWORD=sellmate
POSTGRES_DB=sellmate

# --- العناوين العامة ---
APP_URL=http://localhost:3000        # عنوان لوحة التحكم (يُستخدم للـ CORS والروابط)
WEBHOOK_URL=http://localhost:4000     # عنوان الـ API العام (لتسجيل webhook تيليجرام). في التطوير استخدم نفقًا (ngrok)
# CORS_ORIGINS=                       # اختياري؛ إن تُرك فارغًا يُستخدم APP_URL

# --- قاعدة البيانات ---
DATABASE_URL=postgresql://sellmate:sellmate@localhost:5432/sellmate?schema=public
REDIS_URL=redis://localhost:6379

# --- المصادقة ---
# سرّ واحد قوي (openssl rand -base64 48). يُشتقّ منه سرّ التحديث تلقائيًا.
JWT_SECRET=change-me-please-use-a-long-random-secret
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600

# --- تيليجرام ---
# كل متجر يربط بوته الخاص من لوحة التحكم. هذا بوت افتراضي/منصّة اختياري.
TELEGRAM_BOT_TOKEN=
# سرّ عام للتحقّق من طلبات webhook. غيّره في الإنتاج.
TELEGRAM_WEBHOOK_SECRET=change-me-telegram-webhook-secret

# --- تشفير الأسرار at-rest ---
# مفتاح تشفير رموز البوتات (base64 لـ 32 بايت): openssl rand -base64 32
# اتركه فارغًا في التطوير. املأه في الإنتاج.
ENCRYPTION_KEY=

# =============================================================================
# الذكاء الاصطناعي — مزوّد قابل للتبديل (لا ربط hard-coded بمزوّد واحد)
# AI_PROVIDER: openai | anthropic | gemini | none
# AI_API_KEY: مفتاح عام يصلح للمزوّد المختار (أو استخدم المفتاح الخاص أدناه)
# =============================================================================
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=                             # اختياري: تجاوز اسم الموديل الافتراضي للمزوّد
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=800
AI_MAX_TOOL_ITERATIONS=5

# مفاتيح/موديلات خاصة (اختيارية — تتجاوز AI_API_KEY عند وجودها)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# =============================================================================
# الدفع — مزوّد قابل للتبديل
# PAYMENT_PROVIDER: stripe | none
# =============================================================================
PAYMENT_PROVIDER=none
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# =============================================================================
# مشرفو المنصّة — إدارة الخطط والأسعار على مستوى SellMate
# قائمة بريد إلكتروني مفصولة بفواصل. هؤلاء فقط يمكنهم تعديل أسعار/حدود الخطط
# عبر PATCH /api/v1/admin/plans/:tier ومن صفحة الاشتراك في اللوحة.
# اتركها فارغة لتعطيل تعديل الخطط من الواجهة.
# =============================================================================
PLATFORM_ADMIN_EMAILS=

# --- لوحة التحكم (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:4000
