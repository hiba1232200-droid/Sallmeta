// =============================================================================
// SellMate AI — Prisma schema (PostgreSQL, multi-tenant)
// كل الكيانات مرتبطة بـ Merchant (المتجر = المستأجر). العزل بين المتاجر أساسي.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -------------------------------- Enums --------------------------------------

enum UserRole {
  OWNER
  ADMIN
  STAFF
}

enum ProductStatus {
  ACTIVE
  OUT_OF_STOCK
  HIDDEN
  ARCHIVED
}

enum StockMovementType {
  PURCHASE
  SALE
  ADJUSTMENT
  RETURN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  COMPLETED
  CANCELLED
}

enum OrderSource {
  TELEGRAM
  DASHBOARD
  API
}

enum ConversationChannel {
  TELEGRAM
}

enum ConversationStatus {
  AI_ACTIVE
  WAITING_FOR_HUMAN
  HUMAN_ACTIVE
  CLOSED
}

enum MessageRole {
  CUSTOMER
  ASSISTANT
  AGENT
  SYSTEM
  TOOL
}

enum PlanTier {
  FREE
  STARTER
  PRO
  BUSINESS
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum UsageMetric {
  AI_MESSAGE
  ORDER_CREATED
  TELEGRAM_MESSAGE
}

enum KnowledgeCategory {
  STORE_INFO
  SHIPPING
  EXCHANGE
  RETURN
  PAYMENT
  WORKING_HOURS
  CONTACT
  TERMS
  FAQ
  OTHER
}

// ------------------------------- Tenancy -------------------------------------

model Merchant {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  email       String?
  phone       String?
  description String?  @db.Text
  currency    String   @default("USD")
  locale      String   @default("ar")
  timezone    String   @default("Asia/Damascus")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users          User[]
  products       Product[]
  stockMovements StockMovement[]
  customers      Customer[]
  conversations  Conversation[]
  messages       Message[]
  faqs             Faq[]
  knowledgeEntries KnowledgeEntry[]
  orders           Order[]
  orderItems     OrderItem[]
  usageRecords   UsageRecord[]
  aiSettings     AiSettings?
  telegramBot    TelegramBot?
  subscription   Subscription?
  notifications  Notification[]

  @@index([isActive])
}

model User {
  id           String    @id @default(cuid())
  merchantId   String
  email        String    @unique
  passwordHash String
  name         String
  role         UserRole  @default(OWNER)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  merchant      Merchant       @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([merchantId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ------------------------------- Catalog -------------------------------------

model Product {
  id             String        @id @default(cuid())
  merchantId     String
  sku            String?
  name           String
  description    String?       @db.Text
  category       String?
  price          Decimal       @db.Decimal(12, 2)
  oldPrice       Decimal?      @db.Decimal(12, 2)
  currency       String?
  stock             Int           @default(0)
  lowStockThreshold Int           @default(5) // حدّ تنبيه المخزون المنخفض
  trackInventory    Boolean       @default(true)
  status            ProductStatus @default(ACTIVE)
  attributes     Json          @default("{}")
  imageUrl       String?
  tags           String[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  merchant       Merchant        @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  orderItems     OrderItem[]
  stockMovements StockMovement[]

  @@unique([merchantId, sku])
  @@index([merchantId, status])
  @@index([merchantId, category])
  @@index([merchantId, name])
}

model StockMovement {
  id              String            @id @default(cuid())
  merchantId      String
  productId       String
  type            StockMovementType
  quantity        Int // موجب = إضافة، سالب = خصم
  reason          String?
  reference       String? // مثال: رقم الطلب
  createdByUserId String?
  createdAt       DateTime          @default(now())

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([merchantId, productId])
  @@index([merchantId, createdAt])
}

// ------------------------------ Customers ------------------------------------

model Customer {
  id           String   @id @default(cuid())
  merchantId   String
  telegramId   BigInt
  username     String?
  firstName    String?
  lastName     String?
  phone        String?
  languageCode String?
  notes        String?  @db.Text
  lastSeenAt   DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  merchant      Merchant       @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  orders        Order[]

  @@unique([merchantId, telegramId])
  @@index([merchantId])
}

// ---------------------------- Conversations ----------------------------------

model Conversation {
  id            String              @id @default(cuid())
  merchantId    String
  customerId    String
  channel       ConversationChannel @default(TELEGRAM)
  externalChatId String
  status        ConversationStatus  @default(AI_ACTIVE)
  lastMessageAt DateTime            @default(now())
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  merchant Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  customer Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  messages Message[]
  orders   Order[]

  @@unique([merchantId, externalChatId])
  @@index([merchantId, customerId])
  @@index([merchantId, status])
}

model Message {
  id             String      @id @default(cuid())
  conversationId String
  merchantId     String
  role           MessageRole
  content        String      @db.Text
  toolName       String?
  metadata       Json?
  createdAt      DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  merchant     Merchant     @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([merchantId, createdAt])
}

// -------------------------------- FAQs ---------------------------------------

model Faq {
  id         String   @id @default(cuid())
  merchantId String
  question   String   @db.Text
  answer     String   @db.Text
  tags       String[]
  isActive   Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId, isActive])
}

// قاعدة معرفة المتجر (سياسات، معلومات، شروط...) — مصدر تأصيل إضافي للمساعد عبر الاسترجاع (RAG).
// معزولة تمامًا لكل متجر عبر merchantId.
model KnowledgeEntry {
  id         String            @id @default(cuid())
  merchantId String
  category   KnowledgeCategory @default(OTHER)
  title      String
  content    String            @db.Text
  tags       String[]
  isActive   Boolean           @default(true)
  sortOrder  Int               @default(0)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId, category])
  @@index([merchantId, isActive])
}

// ------------------------------- Orders --------------------------------------

model Order {
  id              String      @id @default(cuid())
  merchantId      String
  customerId      String?
  conversationId  String?
  number          String
  status          OrderStatus @default(PENDING)
  source          OrderSource @default(TELEGRAM)
  currency        String      @default("USD")
  subtotal        Decimal     @db.Decimal(12, 2)
  discount        Decimal     @db.Decimal(12, 2) @default(0)
  total           Decimal     @db.Decimal(12, 2)
  customerName    String?
  customerPhone   String?
  customerAddress String?     @db.Text
  notes           String?     @db.Text
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  merchant     Merchant      @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  customer     Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  items        OrderItem[]

  @@unique([merchantId, number])
  @@index([merchantId, status])
  @@index([merchantId, createdAt])
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  merchantId  String
  productId   String?
  productName String
  unitPrice   Decimal @db.Decimal(12, 2)
  quantity    Int
  lineTotal   Decimal @db.Decimal(12, 2)

  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  product  Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([merchantId])
}

// ------------------------------ AI settings ----------------------------------

model AiSettings {
  id                 String   @id @default(cuid())
  merchantId         String   @unique
  assistantName      String   @default("مساعد المبيعات")
  persona            String   @default("") @db.Text
  welcomeMessage     String   @default("") @db.Text
  fallbackMessage    String   @default("عذرًا، لا أملك هذه المعلومة حاليًا. سأحوّلك إلى فريق المتجر للتأكد.") @db.Text
  language           String   @default("ar")
  temperature        Float    @default(0.2)
  maxTokens          Int      @default(800)
  allowOrderCreation Boolean  @default(true)
  handoffKeywords    String[]
  enabled            Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
}

// ----------------------------- Telegram bot ----------------------------------

model TelegramBot {
  id               String    @id @default(cuid())
  merchantId       String    @unique
  botToken         String // ملاحظة أمنية: يُشفَّر at-rest في الإنتاج (انظر EncryptionService)
  botUsername      String?
  ownerChatId      String? // معرّف محادثة المالك لاستقبال إشعارات الطلبات
  webhookSecret    String
  isActive         Boolean   @default(false)
  lastSetWebhookAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
}

// --------------------------- Billing / usage ---------------------------------

model Plan {
  id                  String   @id @default(cuid())
  tier                PlanTier @unique
  name                String
  priceMonthly        Decimal  @db.Decimal(12, 2)
  currency            String   @default("USD")
  monthlyMessageLimit Int      @default(500) // -1 = بلا حدود
  productLimit        Int      @default(50) // -1 = بلا حدود
  staffLimit          Int      @default(1) // -1 = بلا حدود
  features            Json     @default("{}")
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id                     String             @id @default(cuid())
  merchantId             String             @unique
  planId                 String
  status                 SubscriptionStatus @default(TRIALING)
  currentPeriodStart     DateTime           @default(now())
  currentPeriodEnd       DateTime
  trialEndsAt            DateTime?
  cancelAtPeriodEnd      Boolean            @default(false)
  externalCustomerId     String?
  externalSubscriptionId String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  plan     Plan     @relation(fields: [planId], references: [id])

  @@index([status])
}

model UsageRecord {
  id         String      @id @default(cuid())
  merchantId String
  metric     UsageMetric
  period     String // 'YYYY-MM'
  count      Int         @default(0)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@unique([merchantId, metric, period])
  @@index([merchantId, period])
}

// سجلّ تدقيق أمني (append-only). لا علاقة FK بالمتجر عمدًا حتى تبقى السجلّات
// محفوظة حتى بعد حذف المتجر (للمراجعة والامتثال).
model AuditLog {
  id         String   @id @default(cuid())
  merchantId String? // نطاق المتجر (إن وُجد)
  actorId    String? // معرّف المستخدم المنفِّذ (null للنظام/غير مُصادَق)
  actorEmail String? // بريد المنفِّذ وقت الحدث (لقطة تاريخية)
  action     String // مثل: AUTH_LOGIN_SUCCESS، USER_CREATE، PLAN_EDIT
  targetType String? // نوع الكيان المتأثر: User/Plan/Subscription/Store/Bot
  targetId   String?
  ip         String?
  userAgent  String?
  metadata   Json? // تفاصيل إضافية غير حسّاسة (لا كلمات مرور/أسرار)
  createdAt  DateTime @default(now())

  @@index([merchantId, createdAt])
  @@index([action, createdAt])
}

// سجلّ المدفوعات (append-only). بلا FK للمتجر ليبقى السجلّ المالي محفوظًا حتى بعد حذف المتجر.
model Payment {
  id         String   @id @default(cuid())
  merchantId String
  amount     Decimal  @db.Decimal(10, 2)
  currency   String   @default("USD")
  status     String // PAID | PENDING | FAILED | REFUNDED
  provider   String // stripe | none
  planTier   String?
  externalId String? // معرّف الجلسة/العملية لدى المزوّد
  createdAt  DateTime @default(now())

  @@index([merchantId, createdAt])
  @@index([status, createdAt])
}

enum NotificationType {
  NEW_ORDER
  NEW_CUSTOMER
  HUMAN_ASSISTANCE_REQUIRED
  LOW_STOCK
  SUBSCRIPTION_EXPIRING
  USAGE_LIMIT_NEAR
}

// إشعارات صاحب المتجر (تُخزَّن للعرض في اللوحة، وتُرسَل أيضًا عبر تيليجرام).
model Notification {
  id         String           @id @default(cuid())
  merchantId String
  type       NotificationType
  title      String
  body       String           @db.Text
  data       Json?
  isRead     Boolean          @default(false)
  createdAt  DateTime         @default(now())

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId, createdAt])
  @@index([merchantId, isRead])
}

// سجلّ أخطاء الخادم (5xx) لعرضها في لوحة المشرف.
model ErrorLog {
  id         String   @id @default(cuid())
  requestId  String?
  method     String?
  path       String?  @db.Text
  statusCode Int
  message    String?  @db.Text
  stack      String?  @db.Text
  merchantId String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([statusCode, createdAt])
}
